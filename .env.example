# -------------------------------------------------------------
# AI Life Assistant - Environment Configuration Template
# -------------------------------------------------------------
# Duplicate this file to '.env' in the same directory and fill in your keys:
# cp .env.example .env

# Your Google Gemini Developer API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_memory
DB_USER=postgres
DB_PASSWORD=password

# Unified assistant API (python api/main.py)
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins for Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
